{
  "info": {
    "name": "Fintech Bank API",
    "description": "Coleção de endpoints para testar a API do Fintech Bank",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Cadastrar Usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"João Silva\",\n  \"cpf\": \"12345678901\",\n  \"email\": \"joao@teste.com\",\n  \"senha\": \"MinhaSenh@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "signup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.token) {",
                  "        pm.collectionVariables.set('token', response.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"00000000000\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.token) {",
                  "        pm.collectionVariables.set('token', response.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Usuário",
      "item": [
        {
          "name": "Buscar Dados do Usuário",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/00000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "00000000000"]
            }
          }
        },
        {
          "name": "Consultar Saldo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/saldo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "saldo"]
            }
          }
        }
      ]
    },
    {
      "name": "PIX",
      "item": [
        {
          "name": "Realizar PIX",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpfOrigem\": \"00000000000\",\n  \"cpfDestino\": \"12345678901\",\n  \"valor\": 100.50,\n  \"descricao\": \"Teste PIX via Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pix",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pix"]
            }
          }
        }
      ]
    },
    {
      "name": "Administração",
      "item": [
        {
          "name": "Listar Usuários",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            }
          }
        },
        {
          "name": "Dashboard Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard"]
            }
          }
        },
        {
          "name": "Atualizar Limites PIX",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dailyLimit\": 5000.00,\n  \"monthlyLimit\": 50000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/user/12345678901/limits",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "user", "12345678901", "limits"]
            }
          }
        },
        {
          "name": "Alterar Status do Usuário",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"blocked\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/user/12345678901/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "user", "12345678901", "status"]
            }
          }
        },
        {
          "name": "Ver Transações do Usuário",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/user/12345678901/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "user", "12345678901", "transactions"]
            }
          }
        }
      ]
    }
  ]
}