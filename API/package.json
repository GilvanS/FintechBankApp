{
  "name": "fintech-bank-app-api",
  "version": "1.0.0",
  "description": "Backend API for FintechBankApp",
  "main": "index.cjs",
  "type": "",
  "scripts": {
    "start": "node index.cjs",
    "dev": "node --watch index.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:signup": "jest tests/unit/signup.test.js",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:newman": "node scripts/run-newman-tests.js",
    "test:api": "node scripts/run-newman-tests.js",
    "test:trigger": "node scripts/test_invoice_immutability_trigger.cjs",
    "migrate:signup": "node scripts/run-migration-signup-defaults.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:list",
    "seed:test": "node scripts/seed-test-users.js",
    "seed:telegram": "node scripts/seed_telegram_settings.js",
    "swagger": "node swagger-generate.js",
    "audit:consistency": "node scripts/run_audit_consistency_report.js",
    "audit:report": "node scripts/run_audit_consistency_report.js --open",
    "audit:csv": "node scripts/run_audit_consistency_report.js --csv",
    "audit:all": "node scripts/run_audit_all.js",
    "validate:rules": "node scripts/validate_skill_rules.js",
