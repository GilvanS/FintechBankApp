{
  "name": "fintech-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor da FintechBankApp integrado com Databricks",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "newman run ../postman-collection.json --reporters cli,html,json --reporter-html-export newman-report.html --reporter-json-export newman-report.json --timeout 30000 --delay-request 500 --insecure",
    "test:admin": "newman run ../postman-collection.json --folder \"👨‍💼 ADMIN\" --reporters cli,html,json --reporter-html-export newman-admin-report.html --reporter-json-export newman-admin-report.json --timeout 30000 --delay-request 500 --insecure",
    "test:js": "node run-newman-tests.js",
    "test:ps": "powershell -ExecutionPolicy Bypass -File run-newman-tests.ps1",
    "install-newman": "npm install -g newman newman-reporter-html"
  },
  "dependencies": {
    "@databricks/sql": "^1.12.0",
    "axios": "^1.13.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "newman": "^6.1.2",
    "newman-reporter-html": "^1.0.5",
    "nodemon": "^3.1.0"
  }
}
