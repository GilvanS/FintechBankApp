    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.10",
    "mysql2": "^3.9.7",
    "newman-reporter-html": "^1.0.5",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
