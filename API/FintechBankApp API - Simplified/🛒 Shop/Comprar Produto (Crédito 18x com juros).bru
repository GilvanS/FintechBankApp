      }
    ],
    "paymentMethod": "credit",
    "installments": 18,
    "interestRate": 0.05,
    "pin": "9898"
  }
}

script:post-response {
  test('Status 201', () => res.getStatus() === 201);
}

settings {
  encodeUrl: true
}

docs {
  Compra produto parcelado de 13x até 24x com juros (1% a 7%)
}
