meta {
  name: Compra Fechada (Vista)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/admin/users/{{userCpf}}/card/purchase/closed
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 300.00,
    "description": "Compra vista fechada",
    "installments": 1
  }
}

script:post-response {
  test('Status 201', () => res.getStatus() === 201);
}

settings {
  encodeUrl: true
}

docs {
  Registra compra na fatura fechada (à vista com 10% desconto)
}
