meta {
  name: Pagar Fatura
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cards/invoice/pay
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cpf": "{{userCpf}}",
    "pin": "9898"
  }
}

script:post-response {
  test('Status 200 ou 400', () => [200, 400].includes(res.getStatus()));
}

settings {
  encodeUrl: true
}

docs {
  Paga fatura do cartão sempre com PIN 9898
}
