meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cpf": "{{userCpf}}",
    "password": "senha123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
      const json = res.getBody();
      if (json.token) {
          bru.setVar('token', json.token);
          bru.setEnvVar('token', json.token);
      }
  }
  test('Status 200', () => res.getStatus() === 200);
  expect(res.getBody().success).to.be.true;
}

settings {
  encodeUrl: true
}

docs {
  Login normal de usuário
}
