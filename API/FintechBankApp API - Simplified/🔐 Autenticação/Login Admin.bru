meta {
  name: Login Admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cpf": "{{adminCpf}}",
    "password": "admin999"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
      const json = res.getBody();
      if (json.token) {
          bru.setVar('adminToken', json.token);
          bru.setEnvVar('adminToken', json.token);
      }
  }
  test('Status 200', () => res.getStatus() === 200);
}

settings {
  encodeUrl: true
}

docs {
  Login de administrador
}
