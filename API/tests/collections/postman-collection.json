    {
      "key": "userCpf",
      "value": "11111111111",
      "type": "string"
    },
    {
      "key": "adminCpf",
      "value": "99999999999",
      "type": "string"
    },
    {
      "key": "destinationCpf1",
      "value": "",
      "type": "string"
    },
    {
      "key": "destinationCpf2",
      "value": "",
      "type": "string"
    },
    {
      "key": "destinationCpf3",
      "value": "",
      "type": "string"
