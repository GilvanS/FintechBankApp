  "item": [
    {
      "name": "🔐 Autenticação",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        pm.environment.set('token', json.token);",
                  "    }",
                  "}",
                  "pm.test('Status 200', () => pm.response.code === 200);",
                  "pm.expect(pm.response.json().success).to.be.true;"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{userCpf}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login normal de usuário"
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('adminToken', json.token);",
                  "        pm.environment.set('adminToken', json.token);",
                  "    }",
                  "}",
                  "pm.test('Status 200', () => pm.response.code === 200);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{adminCpf}}\",\n  \"password\": \"admin999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login de administrador"
          }
        },
        {
          "name": "Cadastrar Usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "function saveDestinationCpf(cpf) {",
                  "  if (!cpf || cpf.length !== 11) return;",
                  "  const env = pm.environment;",
                  "  const cpf1 = env.get('destinationCpf1');",
                  "  const cpf2 = env.get('destinationCpf2');",
                  "  const cpf3 = env.get('destinationCpf3');",
                  "  if (cpf === cpf1 || cpf === cpf2 || cpf === cpf3) return;",
                  "  if (!cpf1) {",
                  "    env.set('destinationCpf1', cpf);",
                  "    console.log('✅ CPF salvo em destinationCpf1:', cpf);",
                  "  } else if (!cpf2) {",
                  "    env.set('destinationCpf2', cpf);",
                  "    console.log('✅ CPF salvo em destinationCpf2:', cpf);",
                  "  } else if (!cpf3) {",
                  "    env.set('destinationCpf3', cpf);",
                  "    console.log('✅ CPF salvo em destinationCpf3:', cpf);",
                  "  } else {",
                  "    env.set('destinationCpf1', cpf2);",
                  "    env.set('destinationCpf2', cpf3);",
                  "    env.set('destinationCpf3', cpf);",
                  "    console.log('✅ CPFs rotacionados. Novo CPF salvo em destinationCpf3:', cpf);",
                  "  }",
                  "}",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.success) {",
                  "    const requestBody = JSON.parse(pm.request.body.raw);",
                  "    if (requestBody.cpf) {",
                  "      saveDestinationCpf(requestBody.cpf);",
                  "    }",
                  "  }",
                  "}",
                  "pm.test('Status 200 ou 201', () => [200, 201].includes(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"João da Silva\",\n  \"cpf\": \"{{userCpf2}}\",\n  \"email\": \"joao@example.com\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "Cadastro de novo usuário. CPF será salvo automaticamente em destinationCpf1/2/3"
          }
        }
      ]
