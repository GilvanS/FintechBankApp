          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.code === 200);",
                  "const arr = pm.response.json();",
                  "if (Array.isArray(arr)) {",
                  "  const inst = arr.find(r => r.type === 'INVOICE_INSTALLMENT');",
                  "  if (inst && inst.id) pm.environment.set('lastInstallmentId', inst.id);",
                  "}"
                ]
              }
            }
          ]
        }
