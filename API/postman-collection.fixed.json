{
  "info": {
    "name": "FintechBankApp API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api" },
    { "key": "cpf", "value": "12345678901" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\"cpf\":\"{{cpf}}\",\"password\":\"senha123\"}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.code === 200);",
            "const json = pm.response.json();",
            "pm.environment.set('token', json.token);",
            "pm.expect(json.success).to.be.true;"
          ]
        }
      }]
    },
    {
      "name": "Users - Me (401 sem token)",
      "request": { "method": "GET", "url": "{{baseUrl}}/users/me" },
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('Status 401', () => pm.response.code === 401);"] }
      }]
    },
    {
      "name": "Users - Me (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/users/me"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.code === 200);",
            "pm.expect(pm.response.json().success).to.be.true;"
          ]
        }
      }]
    },
    {
      "name": "PIX - Recipient Info (404 chave inexistente)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/pix/recipient-info",
        "body": { "mode": "raw", "raw": "{\"type\":\"EMAIL\",\"key\":\"nao@existe.com\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.code === 404);"] } }]
    },
    {
      "name": "PIX - Transfer (400 sem PIN)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/pix/transfer",
        "body": { "mode": "raw", "raw": "{\"toKey\":\"EMAIL:user@example.com\",\"amount\":10}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.code === 400);"] } }]
    },
    {
      "name": "PIX - Transfer (200)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/pix/transfer",
        "body": { "mode": "raw", "raw": "{\"toKey\":\"EMAIL:dest@example.com\",\"amount\":5,\"pin\":\"1234\",\"description\":\"Teste\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.code === 200);"] } }]
    },
    {
      "name": "Cartão - Pay (400 sem PIN)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/cards/invoice/pay",
        "body": { "mode": "raw", "raw": "{\"cpf\":\"{{cpf}}\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.code === 400);"] } }]
    },
    {
      "name": "Cartão - Pay (200)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/cards/invoice/pay",
        "body": { "mode": "raw", "raw": "{\"cpf\":\"{{cpf}}\",\"pin\":\"1234\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200/400 dinamico', () => [200,400].includes(pm.response.code));"] } }]
    },
    {
      "name": "Shop - Checkout (400 sem PIN)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/shop/checkout",
        "body": { "mode": "raw", "raw": "{\"items\":[{\"productId\":\"prod-001\",\"quantity\":1}],\"paymentMethod\":\"debit\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.code === 400);"] } }]
    },
    {
      "name": "Shop - Checkout (201 débito)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/shop/checkout",
        "body": { "mode": "raw", "raw": "{\"items\":[{\"productId\":\"prod-001\",\"quantity\":2}],\"paymentMethod\":\"debit\",\"cashbackUsed\":1.5,\"pin\":\"1234\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.code === 201);"] } }]
    },
    {
      "name": "Admin - List Users (403 sem admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/admin/users"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 403', () => pm.response.code === 403);"] } }]
    },
    {
      "name": "Proxy - News (200 cache)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/proxy/news"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.code === 200);"] } }]
    }
  ]
}