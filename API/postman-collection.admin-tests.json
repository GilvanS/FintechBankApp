            "body": { "mode": "raw", "raw": "{\"toKey\":\"{{cpfB}}\",\"amount\":50.00,\"description\":\"Teste PIX\",\"pin\":\"1234\"}" }
          }
        },
        {
          "name": "PIX - Transfer Credit (12x)",
          "request": {
            "method": "POST",
