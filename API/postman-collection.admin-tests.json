{
  "info": {
    "name": "FintechBankApp - Full API (Admin Purchases & Invoice)",
    "_postman_id": "2f3a1f6b-9f65-4a4e-95c1-collection-admin-tests",
    "description": "Colecao derivada do Swagger com rotas principais e novas rotas admin de compras (aberta/fechada) e status de fatura. Usa environment para token e IDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Auth - Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"cpf\":\"{{adminCpf}}\",\"password\":\"{{adminPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200', () => pm.response.code === 200);",
                  "const json = pm.response.json();",
                  "if (json && json.token) { pm.environment.set('token', json.token); } else { pm.test('Resposta contem token', () => false); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Signup - Usuario A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\":\"Usuario Teste A\",\"cpf\":\"{{cpfA}}\",\"email\":\"teste.a@example.com\",\"password\":\"teste123\"}"
            }
          }
        },
        {
          "name": "Signup - Usuario B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\":\"Usuario Teste B\",\"cpf\":\"{{cpfB}}\",\"email\":\"teste.b@example.com\",\"password\":\"teste123\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Users - Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Users - Get A",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{cpfA}}"
          }
        },
        {
          "name": "Users - Get B",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{cpfB}}"
          }
        },
        {
          "name": "Users - Statement A (captura IDs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{cpfA}}/statement"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.code === 200);",
                  "const arr = pm.response.json();",
                  "if (Array.isArray(arr)) {",
                  "  const inst = arr.find(r => r.type === 'INVOICE_INSTALLMENT');",
                  "  if (inst && inst.id) pm.environment.set('lastInstallmentId', inst.id);",
                  "  const cred = arr.find(r => r.type === 'CREDIT');",
                  "  if (cred && cred.id) pm.environment.set('lastCreditTransactionId', cred.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Users - Statement B",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{cpfB}}/statement"
          }
        },
        {
          "name": "Users - Purchases A",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{cpfA}}/purchases"
          }
        }
      ]
    },
    {
      "name": "Admin - Users",
      "item": [
        {
          "name": "Admin - List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Admin - Get Usuario A",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/users/{{cpfA}}"
          }
        },
        {
          "name": "Admin - Deposit A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/users/{{cpfA}}/deposit",
            "body": { "mode": "raw", "raw": "{\"amount\":250.00}" }
          }
        },
        {
          "name": "Admin - Card Details A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/users/{{cpfA}}/card-details",
            "body": { "mode": "raw", "raw": "{\"availableLimit\":5000,\"totalLimit\":8000,\"invoiceDueDate\":\"2025-12-10\"}" }
          }
        }
      ]
    },
    {
      "name": "Admin - Purchases (Regras Novas)",
      "item": [
        {
          "name": "Compra ABERTA (Vista - 10% desconto)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/users/{{cpfA}}/card/purchase/open",
            "body": { "mode": "raw", "raw": "{\"amount\":500.00,\"description\":\"Compra vista aberta\",\"installments\":1}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('201 Created', () => pm.response.code === 201);",
                "const json = pm.response.json();",
                "if (json && json.transactionId) pm.environment.set('purchaseOpenTransactionId', json.transactionId);"
              ] }
            }
          ]
        },
        {
          "name": "Compra ABERTA (2..12 Sem Juros)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/users/{{cpfA}}/card/purchase/open",
            "body": { "mode": "raw", "raw": "{\"amount\":1200.00,\"description\":\"Notebook aberto\",\"installments\":12}" }
          }
        },
        {
          "name": "Compra ABERTA (13..24 Com Juros 1%..7%)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/users/{{cpfA}}/card/purchase/open",
            "body": { "mode": "raw", "raw": "{\"amount\":2000.00,\"description\":\"TV 75 aberto\",\"installments\":18,\"interestRate\":0.05}" }
          }
        },
        {
          "name": "Compra FECHADA (Vista - 10% desconto)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/users/{{cpfB}}/card/purchase/closed",
            "body": { "mode": "raw", "raw": "{\"amount\":300.00,\"description\":\"Ajuste vista fechada\",\"installments\":1}" }
          }
        },
        {
          "name": "Compra FECHADA (2..12 Sem Juros)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/users/{{cpfB}}/card/purchase/closed",
            "body": { "mode": "raw", "raw": "{\"amount\":900.00,\"description\":\"Ajuste parcelado fechado\",\"installments\":6}" }
          }
        },
        {
          "name": "Compra FECHADA (13..24 Com Juros 1%..7%)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/users/{{cpfB}}/card/purchase/closed",
            "body": { "mode": "raw", "raw": "{\"amount\":2400.00,\"description\":\"Ajuste parcelado juros fechado\",\"installments\":20,\"interestRate\":0.07}" }
          }
        }
      ]
    },
    {
      "name": "Admin - Invoices",
      "item": [
        {
          "name": "Invoice Status (usar invoiceId manual)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/invoices/{{cpfA}}/{{invoiceId}}/status",
            "body": { "mode": "raw", "raw": "{\"status\":\"ABERTA\"}" }
          }
        }
      ]
    },
    {
      "name": "Shop",
