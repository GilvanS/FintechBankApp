              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/pix/transfer-credit",
            "body": { "mode": "raw", "raw": "{\"fromCpf\":\"{{cpfA}}\",\"toKey\":\"{{cpfB}}\",\"amount\":120.00,\"description\":\"PIX Credit\",\"installments\":12,\"interestRate\":0.02,\"pin\":\"1234\"}" }
          }
        }
